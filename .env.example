# Contact form — Cloudflare Turnstile (bot check)
# Public site key, safe to expose to the client.
# Falls back to Cloudflare's public test key in code if unset locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key, server-only. Never expose to the client.
# Falls back to Cloudflare's public test secret in code if unset locally.
TURNSTILE_SECRET_KEY=

# Contact form — Resend (email delivery)
# Server-only. No local fallback — if unset, the contact route fails
# gracefully with a generic error instead of sending mail.
RESEND_API_KEY=

# Server-only. Inbox that receives contact-form submissions.
CONTACT_TO_EMAIL=
